{% assign locale = include.locale | default: site.locale %}
<nav class="nav__list">
  {% if page.sidebar.title %}<h3 class="nav__title" style="padding-inline-start: 0;">{{ page.sidebar.title }}</h3>{% endif %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% for navname in include.nav %}
      {% assign navigation = site.data.navigation[navname] %}
      {% for nav in navigation %}
        <li>
          {% if nav.title %}
           {% assign nav_cat = site.categories[nav.title] %}
           <span class="nav__sub-title">
             {{ nav.title }}
             {% if nav_cat %}<span class="nav__sub-title-count">({{ nav_cat.size }})</span>{% endif %}
           </span>
         {% endif %}

          {% if nav.children != null %}
          <ul>
            {% for child in nav.children %}
              <li>
                {% assign child_cat = site.categories[child.title] %}
                {% if child.url %}
                  <a href="{{ child.url | relative_url }}" {% if child.url == page.url %}class="active"{% endif %}>
                    {{ child.title }} 
                    {% if child_cat %}<span class="nav__sub-title-count">({{ child_cat.size }})</span>{% endif %}
                  </a>
                {% else %}
                  <span class="nav__sub-title">
                    {{ child.title }}
                    {% if child_cat %}<span class="nav__sub-title-count">({{ child_cat.size }})</span>{% endif %}
                  </span>
                {% endif %}

                {% if child.children %}
                  <ul>
                    {% for grand_child in child.children %}
                      <li>
                        {% assign grand_child_cat = site.categories[grand_child.title] %}
                        {% if grand_child.url %}
                          <a href="{{ grand_child.url | relative_url }}" {% if grand_child.url == page.url %}class="active"{% endif %}>
                            {{ grand_child.title }}
                            {% if grand_child_cat %}<span class="nav__sub-title-count">({{ grand_child_cat.size }})</span>{% endif %}
                          </a>
                        {% else %}
                          <span>
                            {{ grand_child.title }}
                            {% if grand_child_cat %}<span class="nav__sub-title-count">({{ grand_child_cat.size }})</span>{% endif %}
                          </span>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
                </li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
      {% endfor %}
    {% endfor %}
  </ul>
</nav>